@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# SDL3_ttf links the freetype target installed with asw, which needs the
# libraries freetype was built with
foreach(dep IN ITEMS @ASW_FREETYPE_DEPENDENCIES@)
  find_dependency(${dep})
endforeach()
find_dependency(freetype CONFIG)
find_dependency(SDL3 CONFIG)
find_dependency(SDL3_image CONFIG)
find_dependency(SDL3_ttf CONFIG)
find_dependency(SDL3_mixer CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components(@PROJECT_NAME@)
